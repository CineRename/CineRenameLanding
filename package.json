{
  "name": "cinerename-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:prod": "NODE_ENV=production next build",
    "start:prod": "NODE_ENV=production next start",
    "cf:build": "opennextjs-cloudflare build && npm run docs:build",
    "cf:deploy-built": "opennextjs-cloudflare deploy -c wrangler.deploy.toml",
    "cf:upload-built": "opennextjs-cloudflare upload -c wrangler.deploy.toml",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run cf:deploy-built",
    "upload": "npm run cf:build && npm run cf:upload-built",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@swc/helpers": "0.5.21",
    "lucide-react": "^0.539.0",
    "next": "15.5.18",
    "next-intl": "^4.3.4",
    "posthog-js": "^1.155.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitepress": "^1.5.0",
    "wrangler": "^4.84.1"
  },
  "overrides": {
    "@docsearch/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
